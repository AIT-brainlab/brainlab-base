#cloud-config
hostname: ${vm_name}
timezone: Asia/Bangkok
manage_etc_hosts: true

users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: docker, sudo
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

package_update: true
package_upgrade: false

packages:
  - curl
  - jq
  - git
  - ca-certificates
  - qemu-guest-agent
  - docker.io
  - docker-compose-v2

runcmd:
  # 1. Enable Docker & QEMU Guest Agent Services
  - systemctl enable --now docker
  - systemctl enable --now qemu-guest-agent
  
  # 2. Enroll into NetBird Mesh via CSIM Proxy Bootstrapper
%{ if netbird_setup_key != "" ~}
  - curl -fsSL -x http://192.41.170.82:3128 https://raw.githubusercontent.com/AIT-brainlab/brainlab-base/main/docs/infra/onprem/scripts/bootstrap_netbird_csim.sh | bash -s -- ${netbird_setup_key}
%{ endif ~}

final_message: "AIT Brainlab Proxmox Application VM initialization complete after $UPTIME seconds"
