#!/usr/bin/env bash
# ==========================================================
# 🚀 Brainlab Management VM Automation & Startup Script
# ==========================================================
set -euo pipefail

echo "=========================================================="
echo "🚀 [1/5] Updating OS Packages & Installing Docker CE..."
echo "=========================================================="
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y --no-install-recommends docker.io docker-compose-v2 sqlite3 curl jq

echo "=========================================================="
echo "⚡ [2/5] Enabling System Services & Setting Asia/Bangkok Timezone..."
echo "=========================================================="
timedatectl set-timezone Asia/Bangkok
ln -sf /usr/share/zoneinfo/Asia/Bangkok /etc/localtime
echo "Asia/Bangkok" > /etc/timezone
systemctl restart systemd-journald
systemctl enable docker
systemctl start docker

echo "=========================================================="
echo "📁 [3/5] Restoring SQLite State from GCS & Preparing Dirs..."
echo "=========================================================="
mkdir -p /opt/brainlab/traefik /opt/brainlab/lldap/data /opt/brainlab/netbird/data /opt/brainlab/scripts
touch /opt/brainlab/traefik/acme.json
chmod 600 /opt/brainlab/traefik/acme.json

# Restore LLDAP Database from GCS if exists
if gcloud storage cp "gs://${state_bucket}/backups/lldap/users.db" /opt/brainlab/lldap/data/users.db 2>/dev/null; then
    echo "✅ Restored LLDAP users.db from GCS"
    chmod 600 /opt/brainlab/lldap/data/users.db
else
    echo "ℹ️ No previous LLDAP database found in GCS. Starting clean."
fi

# Restore NetBird Database from GCS if exists
if gcloud storage cp "gs://${state_bucket}/backups/netbird/store.db" /opt/brainlab/netbird/data/store.db 2>/dev/null; then
    echo "✅ Restored NetBird store.db from GCS"
    chmod 600 /opt/brainlab/netbird/data/store.db
else
    echo "ℹ️ No previous NetBird database found in GCS. Starting clean."
fi

# Add local loopback entry for self-referential SSL traffic (bypasses GCP Hairpin NAT)
echo "127.0.0.1 ${netbird_subdomain}.${domain} ${lldap_subdomain}.${domain}" >> /etc/hosts

# Generate NetBird Management Configuration with Google OAuth2 enabled
cat << 'EOF' > /opt/brainlab/netbird/management.json
{
  "DataDir": "/var/lib/netbird",
  "HttpConfig": {
    "AuthAudience": "${google_oauth_client_id}",
    "AuthAuthority": "https://accounts.google.com",
    "AuthIssuer": "https://accounts.google.com",
    "AuthKeysLocation": "https://www.googleapis.com/oauth2/v3/certs"
  },
  "IdpManagerConfig": null,
  "SingleAccountModeDomain": "ait.asia",
  "Datadir": "/var/lib/netbird",
  "Signal": {
    "URI": "${netbird_subdomain}.${domain}:443",
    "Proto": "https"
  },
  "EmbeddedIdP": {
    "Enabled": false
  }
}
EOF

echo "=========================================================="
echo "🔐 [4/5] Writing Environment Secrets & Backup Automation..."
echo "=========================================================="
cat << 'EOF' > /opt/brainlab/.env
LLDAP_JWT_SECRET="${lldap_jwt_secret}"
LLDAP_ADMIN_PASSWORD="${lldap_admin_password}"
GOOGLE_OAUTH_CLIENT_ID="${google_oauth_client_id}"
GOOGLE_OAUTH_CLIENT_SECRET="${google_oauth_client_secret}"
EOF
chmod 600 /opt/brainlab/.env

cat << 'EOF' > /opt/brainlab/docker-compose.yml
${docker_compose_content}
EOF

# Create Automated SQLite GCS Backup Script
cat << 'EOF' > /opt/brainlab/scripts/backup_to_gcs.sh
#!/usr/bin/env bash
set -euo pipefail

# Atomic snapshot of LLDAP users.db
if [ -f /opt/brainlab/lldap/data/users.db ]; then
    sqlite3 /opt/brainlab/lldap/data/users.db ".backup /tmp/lldap_users.db"
    gcloud storage cp /tmp/lldap_users.db "gs://${state_bucket}/backups/lldap/users.db" --quiet
    rm -f /tmp/lldap_users.db
fi

# Atomic snapshot of NetBird store.db
if [ -f /opt/brainlab/netbird/data/store.db ]; then
    sqlite3 /opt/brainlab/netbird/data/store.db ".backup /tmp/netbird_store.db"
    gcloud storage cp /tmp/netbird_store.db "gs://${state_bucket}/backups/netbird/store.db" --quiet
    rm -f /tmp/netbird_store.db
fi
EOF
chmod +x /opt/brainlab/scripts/backup_to_gcs.sh

# Install Cron for 6-hourly automated snapshot
(crontab -l 2>/dev/null | grep -v 'backup_to_gcs.sh' || true; echo "0 */6 * * * /opt/brainlab/scripts/backup_to_gcs.sh >/dev/null 2>&1") | crontab -

# Create Systemd Auto-Recovery Unit with Backup on Shutdown
cat << 'EOF' > /etc/systemd/system/brainlab-mgmt.service
[Unit]
Description=AIT Brainlab Management Control Plane (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/brainlab
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecStopPost=/opt/brainlab/scripts/backup_to_gcs.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable brainlab-mgmt.service

echo "=========================================================="
echo "🐳 [5/5] Launching Traefik, LLDAP, and NetBird Containers..."
echo "=========================================================="
cd /opt/brainlab
docker compose pull --quiet
docker compose up -d --remove-orphans

echo "==> ⏳ Verifying control plane containers..."
sleep 3
docker compose ps

echo "=========================================================="
echo "🎉 ALL BRAINLAB MANAGEMENT SERVICES ARE OPERATIONAL!"
echo "=========================================================="

