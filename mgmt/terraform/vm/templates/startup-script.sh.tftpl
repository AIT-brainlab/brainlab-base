#!/usr/bin/env bash
# ==========================================================
# 🚀 Brainlab Management VM Automation & Startup Script
# ==========================================================
set -euo pipefail

echo "=========================================================="
echo "🚀 [1/5] Updating OS Packages & Installing Docker CE..."
echo "=========================================================="
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io docker-compose-v2 unattended-upgrades curl jq

echo "=========================================================="
echo "⚡ [2/5] Enabling System Services & Setting Asia/Bangkok Timezone..."
echo "=========================================================="
timedatectl set-timezone Asia/Bangkok
ln -sf /usr/share/zoneinfo/Asia/Bangkok /etc/localtime
echo "Asia/Bangkok" > /etc/timezone
systemctl restart systemd-journald
systemctl enable docker
systemctl start docker
systemctl enable unattended-upgrades
systemctl start unattended-upgrades

echo "=========================================================="
echo "📁 [3/5] Preparing Traefik ACME & Data Directories..."
echo "=========================================================="
mkdir -p /opt/brainlab/traefik /opt/brainlab/lldap/data /opt/brainlab/netbird/data /opt/brainlab/netbird/idp
touch /opt/brainlab/traefik/acme.json
chmod 600 /opt/brainlab/traefik/acme.json

# Add local loopback entry for self-referential SSL traffic (bypasses GCP Hairpin NAT)
echo "127.0.0.1 ${netbird_staging_subdomain}.${domain} authen2.${domain}" >> /etc/hosts

# Generate NetBird Management Configuration with Embedded IdP enabled
cat << 'EOF' > /opt/brainlab/netbird/management.json
{
  "DataDir": "/var/lib/netbird",
  "HttpConfig": {
    "AuthAudience": "netbird-dashboard",
    "AuthAuthority": "https://${netbird_staging_subdomain}.${domain}/oauth2",
    "AuthIssuer": "https://${netbird_staging_subdomain}.${domain}/oauth2",
    "AuthKeysLocation": ""
  },
  "IdpManagerConfig": null,
  "SingleAccountModeDomain": "",
  "Datadir": "/var/lib/netbird",
  "Signal": {
    "URI": "${netbird_staging_subdomain}.${domain}:443",
    "Proto": "https"
  },
  "EmbeddedIdP": {
    "Enabled": true,
    "Issuer": "https://${netbird_staging_subdomain}.${domain}/oauth2",
    "DataDir": "/var/lib/netbird/idp"
  }
}
EOF

echo "=========================================================="
echo "🔐 [4/5] Writing Environment Secrets & Compose Manifest..."
echo "=========================================================="
cat << 'EOF' > /opt/brainlab/.env
LLDAP_JWT_SECRET="${lldap_jwt_secret}"
LLDAP_ADMIN_PASSWORD="${lldap_admin_password}"
EOF
chmod 600 /opt/brainlab/.env

cat << 'EOF' > /opt/brainlab/docker-compose.yml
${docker_compose_content}
EOF

# Create Systemd Auto-Recovery Unit
cat << 'EOF' > /etc/systemd/system/brainlab-mgmt.service
[Unit]
Description=AIT Brainlab Management Control Plane (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/brainlab
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable brainlab-mgmt.service

echo "=========================================================="
echo "🐳 [5/5] Launching Traefik, LLDAP, and NetBird Containers..."
echo "=========================================================="
cd /opt/brainlab
docker compose up -d --remove-orphans

echo "=========================================================="
echo "🔑 Initializing NetBird Master Account & PAT in Secret Manager..."
echo "=========================================================="
for i in $(seq 1 30); do
  HTTP_CODE=$(curl -s -o /dev/null -w "%%{http_code}" http://127.0.0.1:80/api/users || echo "000")
  if [ "$HTTP_CODE" -eq 401 ] || [ "$HTTP_CODE" -eq 200 ]; then
    break
  fi
  sleep 2
done

if ! gcloud secrets describe netbird-mgmt-token --project="${project_id}" >/dev/null 2>&1; then
  SETUP_RESP=$(curl -s -X POST http://127.0.0.1:80/api/setup \
    -H 'Content-Type: application/json' \
    -d "{\"name\": \"Brainlab Master\", \"email\": \"brainlab@ait.asia\", \"password\": \"${lldap_admin_password}\", \"create_pat\": true}")

  PAT=$(echo "$SETUP_RESP" | grep -o '"personal_access_token":"[^"]*' | cut -d'"' -f4 || true)

  if [ -n "$PAT" ]; then
    echo -n "$PAT" | gcloud secrets create netbird-mgmt-token \
      --data-file=- \
      --project="${project_id}"
    echo "✅ netbird-mgmt-token successfully stored in GCP Secret Manager!"
  else
    echo "⚠️ Warning: Could not retrieve PAT from NetBird /api/setup"
  fi
else
  echo "ℹ️ netbird-mgmt-token already exists in Secret Manager."
fi

echo "=========================================================="
echo "🎉 ALL BRAINLAB MANAGEMENT SERVICES ARE OPERATIONAL!"
echo "=========================================================="
