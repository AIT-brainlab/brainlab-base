# ==========================================================
# 📡 NetBird VPN Terraform Variables (Example)
# ==========================================================
# Note: NetBird Management API token is fetched dynamically
# from GCP Secret Manager ('netbird-mgmt-token').
# Zero credentials stored in this file!
# ==========================================================
project_id             = "ait-brainlab-mgmt"
region                 = "asia-southeast1"
zone                   = "asia-southeast1-a"
netbird_management_url = "https://netbird2.brain.cs.ait.ac.th"
netbird_client_version = "0.77.0"
