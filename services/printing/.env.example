# Google OAuth2 Credentials (from GCP Secret Manager: google-oauth-client-id / google-oauth-client-secret)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_GOOGLE_CLIENT_SECRET
SESSION_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_32_CHARS

# External URL for OAuth redirect
BASE_URL=https://print.brain.cs.ait.ac.th

# CSIM Print Server Configuration
PRINT_SERVER_HOST=192.41.170.5
PRINT_SERVER_PORT=515

# Default Printers / Queues
# Ricoh IM C2000 (Lobby ground floor): B&W='ricoh', Color='ricoh-colour'
# HP LaserJet P4015x (Room #212): B&W='magnum'
DEFAULT_QUEUE=ricoh
COLOR_QUEUE=ricoh-colour
MAGNUM_QUEUE=magnum

# Identity resolution file (maps alumni gmail to student ID)
MEMBERS_YAML_PATH=/app/members.yaml
