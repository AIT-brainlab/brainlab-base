# ==============================================================================
# AIT Brainlab - Ollama Service Configuration
# Deployed alongside JupyterHub on Server 'la' (dual NVIDIA RTX A6000 - 48GB each)
# Accessible to NetBird clients via MagicDNS: http://la:11434
# ==============================================================================

# Hardware & Docker Deployment Settings
OLLAMA_GPU_ID=1
OLLAMA_PORT=11434
OLLAMA_SYSTEM_RAM_LIMIT=32g

# GPU VRAM Headroom / Reserved Memory (in bytes)
# Formula: (Total GPU VRAM - Desired Ollama VRAM) * 1024^3
# Examples on 48 GB RTX A6000:
#   To give Ollama 24 GB (50%): reserve 24 GB -> 25769803776
#   To give Ollama 30 GB (62%): reserve 18 GB -> 19327352832
#   To give Ollama 18 GB (38%): reserve 30 GB -> 32212254720
OLLAMA_GPU_OVERHEAD=25769803776

# Ollama Server Runtime Settings
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_ORIGINS=*
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2

# NVIDIA MPS Compute Throttling (Caps SM compute to 50% if host MPS is active)
CUDA_MPS_ACTIVE_THREAD_PERCENTAGE=50

# Institutional CSIM Forward Proxy (Rule 21)
# Required for pulling models from registry.ollama.ai through the institutional proxy
HTTP_PROXY=http://192.41.170.82:3128
HTTPS_PROXY=http://192.41.170.82:3128
NO_PROXY=localhost,127.0.0.1,ollama,jupyterhub,brainlab-mgmt-vm,100.64.0.0/10,100.103.0.0/16,172.16.0.0/12,10.0.0.0/8,192.41.170.0/24,*.brain.cs.ait.ac.th
